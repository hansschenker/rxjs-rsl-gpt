{
  "name": "@rxjs-rsl/core",
  "version": "0.0.0",
  "private": true,
  "description": "Reference implementation of RxJS RSL v0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "rxjs": "7.8.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.13.10",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
